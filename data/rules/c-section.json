{
  "procedureCode": "c-section",
  "phases": [
    {
      "name": "early",
      "dayStart": 0,
      "dayEnd": 10,
      "expectedSymptoms": ["lochia_heavy", "incisional_pain", "breast_engorgement", "low_grade_temp"],
      "redFlags": ["fever_38", "wound_dehiscence", "soaking_bleeding", "calf_pain_with_swelling"]
    },
    {
      "name": "late",
      "dayStart": 11,
      "dayEnd": 14,
      "expectedSymptoms": ["incisional_pain", "breast_engorgement"],
      "redFlags": ["fever_38", "wound_dehiscence", "soaking_bleeding", "calf_pain_with_swelling"]
    },
    {
      "name": "extended",
      "dayStart": 15,
      "dayEnd": 42,
      "expectedSymptoms": [],
      "redFlags": ["fever_38", "wound_dehiscence", "soaking_bleeding", "calf_pain_with_swelling"]
    }
  ],
  "rules": [
    {
      "id": "cs-2-001",
      "class": 2,
      "when": { "symptomCode": "lochia_heavy", "phase": "early" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Heavy lochia is expected on days 0-10 after a C-section."
    },
    {
      "id": "cs-2-002",
      "class": 2,
      "when": { "symptomCode": "lochia_heavy", "phase": "late" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Heavy lochia is still within the expected window through day 14."
    },
    {
      "id": "cs-2-003",
      "class": 2,
      "when": { "symptomCode": "lochia_heavy", "phase": "extended" },
      "severity": "CALL_CLINIC",
      "route": "call_clinic",
      "rationale": "Heavy lochia past day 14 is not expected; needs clinic review."
    },
    {
      "id": "cs-2-004",
      "class": 2,
      "when": { "symptomCode": "incisional_pain", "phase": "early" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Incisional pain is expected through day 10 after a C-section."
    },
    {
      "id": "cs-2-005",
      "class": 2,
      "when": { "symptomCode": "incisional_pain", "phase": "late" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Incisional pain is still expected through day 14 after a C-section."
    },
    {
      "id": "cs-2-006",
      "class": 2,
      "when": { "symptomCode": "breast_engorgement", "phase": "early" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Breast engorgement is expected in the first ten days; self-care."
    },
    {
      "id": "cs-2-007",
      "class": 2,
      "when": { "symptomCode": "breast_engorgement", "phase": "late" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Breast engorgement remains self-care in the late phase."
    },
    {
      "id": "cs-2-008",
      "class": 2,
      "when": { "symptomCode": "low_grade_temp", "phase": "early" },
      "severity": "SELF_CARE",
      "route": "self_care",
      "rationale": "Low-grade temperature is expected in the first ten days after a C-section."
    },
    {
      "id": "cs-3-001",
      "class": 3,
      "when": { "patientFlag": "anticoagulated", "symptomCode": "bleeding" },
      "severity": "URGENT_CARE",
      "route": "urgent_care",
      "rationale": "Anticoagulated patient with any bleeding escalates one level."
    },
    {
      "id": "cs-3-002",
      "class": 3,
      "when": { "patientFlag": "diabetic", "symptomCode": "wound_redness" },
      "severity": "URGENT_CARE",
      "route": "urgent_care",
      "rationale": "Diabetic patient with wound redness escalates one level."
    },
    {
      "id": "cs-3-003",
      "class": 3,
      "when": { "patientFlag": "age_70_plus", "symptomCode": "new_confusion" },
      "severity": "EMERGENCY",
      "route": "emergency",
      "rationale": "Age 70 or over with new confusion escalates; confusion is a hard red flag in this band."
    },
    {
      "id": "cs-4-001",
      "class": 4,
      "when": { "extraction": "no_findings" },
      "severity": "CALL_CLINIC",
      "route": "human_review",
      "rationale": "No findings extracted; route to human review rather than reassure."
    },
    {
      "id": "cs-4-002",
      "class": 4,
      "when": { "extraction": "finding_unmapped_to_symptom_code" },
      "severity": "CALL_CLINIC",
      "route": "human_review",
      "rationale": "A finding could not be mapped to a symptom code; human review decides."
    },
    {
      "id": "cs-4-003",
      "class": 4,
      "when": { "extraction": "low_extraction_confidence" },
      "severity": "CALL_CLINIC",
      "route": "human_review",
      "rationale": "Extraction confidence is low; human review decides rather than the rule engine."
    }
  ]
}